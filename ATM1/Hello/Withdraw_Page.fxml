<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="290.0" prefWidth="574.0" style="-fx-background-color: black;" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Withdraw_Page_Controller">
    <stylesheets>
        <URL value="@withdraw_page.css" />
    </stylesheets>
   <children>
      <Label alignment="CENTER" layoutY="14.0" prefHeight="18.0" prefWidth="600.0" text="Please select the amount you want to withdraw" textFill="YELLOW">
         <font>
            <Font name="System Bold Italic" size="16.0" />
         </font>
      </Label>
      <Label layoutX="39.0" layoutY="75.0" prefHeight="18.0" prefWidth="106.0" text="Current Balance :" textFill="YELLOW">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Label fx:id="balance_label" layoutX="189.0" layoutY="75.0" prefHeight="18.0" prefWidth="291.0" text="BDT 000 TK" textFill="YELLOW">
         <font>
            <Font name="System Bold Italic" size="13.0" />
         </font></Label>
      <Label layoutX="35.0" layoutY="115.0" prefHeight="18.0" prefWidth="117.0" text="Withdraw Amount :" textFill="YELLOW">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="withdraw_textfield" layoutX="189.0" layoutY="111.0" />
      <Label layoutX="359.0" layoutY="115.0" text="TK" textFill="YELLOW">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Button layoutX="454.0" layoutY="182.0" mnemonicParsing="false" onMouseClicked="#withdrawConfirm" prefHeight="25.0" prefWidth="70.0" style="-fx-background-color: yellow;" text="Confirm">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Label fx:id="withdraw_warning_label" alignment="CENTER" layoutX="29.0" layoutY="145.0" prefHeight="18.0" prefWidth="495.0" text="Your Account currently does not have sufficient balance for the Withdrawal !!" textFill="#d41212">
         <font>
            <Font name="System Bold Italic" size="13.0" />
         </font></Label>
      <Button layoutX="35.0" layoutY="246.0" mnemonicParsing="false" onAction="#backtoProfile" onMouseClicked="#backtoProfile" style="-fx-background-color: yellow;" text="&lt;&lt;Back">
         <font>
            <Font name="System Bold" size="11.0" />
         </font></Button>
   </children>
</AnchorPane>
