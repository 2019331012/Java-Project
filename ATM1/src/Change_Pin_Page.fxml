<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="430.0" style="-fx-background-color: black;" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Change_Pin_Page_Controller">
    <stylesheets>
        <URL value="@change_pin_page.css" />
    </stylesheets>
   <children>
      <Label layoutX="105.0" layoutY="97.0" text="Old Pin" textFill="YELLOW">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="102.0" layoutY="156.0" text="New Pin" textFill="YELLOW">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <TextField fx:id="oldpin_textfield" layoutX="183.0" layoutY="93.0" />
      <TextField fx:id="newpin_textfield" layoutX="183.0" layoutY="152.0" />
      <Button layoutX="332.0" layoutY="258.0" mnemonicParsing="false" onAction="#pinChange" style="-fx-background-color: yellow;" text="Confirm">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <TextField fx:id="retypepin_textfield" layoutX="183.0" layoutY="211.0" />
      <Label layoutX="71.0" layoutY="215.0" text="Re-type new Pin" textFill="YELLOW">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Button layoutX="27.0" layoutY="352.0" mnemonicParsing="false" onMouseClicked="#backtoProfile" style="-fx-background-color: yellow;" text="&lt;&lt;Back">
         <font>
            <Font name="System Bold" size="11.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
